# ── Large data files — never commit these to GitHub ──────────────────────────
# The raw Lichess PGN files are 15-30 GB each. GitHub has a 100 MB file limit.
# The processed datasets can also be hundreds of MB.
# These are regenerated by running the pipeline scripts from scratch.

data/raw/
data/reference_corpus/
data/processed/

# ── Output files — regenerated by scripts ────────────────────────────────────
outputs/figures/
outputs/tables/

# ── Python cache files — not part of the project ─────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Jupyter notebook checkpoints ──────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environment (if you create one) ───────────────────────────────────
venv/
env/
.venv/

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store          # Mac
Thumbs.db          # Windows
Desktop.ini        # Windows

# ── Stockfish binary — large executable, not source code ─────────────────────
# Reinstall via: bash setup_stockfish.sh
stockfish/
